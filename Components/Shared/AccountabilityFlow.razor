@implements IDisposable
@using Nimbus_Internet_Blocker.Utilities
@inject QuoteService QuoteService
@inject IJSRuntime JS

<div class="af-container">
    @if (_currentIndex < _questions.Count)
    {
        <!-- Progress indicator -->
        <div class="af-progress">
            <div class="af-progress-label">Question @(_currentIndex + 1) of @_questions.Count</div>
            <div class="af-dots">
                @for (int i = 0; i < _questions.Count; i++)
                {
                    var idx = i;
                    var dotClass = idx < _currentIndex  ? "af-dot done"
                                 : idx == _currentIndex ? "af-dot active"
                                 : "af-dot";
                    <div class="@dotClass"></div>
                }
            </div>
        </div>

        <!-- Question text -->
        <p class="af-question">@_questions[_currentIndex].Question</p>

        <!-- Quote box — shown only on the last question so the user can read and type it -->
        @if (_currentIndex == _questions.Count - 1)
        {
            <div class="af-quote-box">
                <div class="af-quote-text">@QuoteService.CurrentQuoteText</div>
            </div>
        }

        <!-- Hint text -->
        <div class="af-hint">@GetHint()</div>

        <!-- Early-exit note for Q3 (urge) -->
        @if (_currentIndex == 2)
        {
            <div class="af-early-exit-note">Choosing "urge" will close this flow.</div>
        }

        <!-- Early-exit note for Q4 (no) -->
        @if (_currentIndex == 3)
        {
            <div class="af-early-exit-note">Choosing "no" will close this flow.</div>
        }

        <!--
            Answer input.
            On the last question: gets id="af-quote-input" so OnAfterRenderAsync can
            attach a paste-prevention listener, matching the pattern in GuardianFlow.razor.
        -->
        <input class="input"
               id="@(_currentIndex == _questions.Count - 1 ? "af-quote-input" : null)"
               type="text"
               placeholder="Type your answer…"
               @bind="_typedAnswer"
               @bind:event="oninput"
               @onkeydown="OnKeyDownAsync" />

        <!-- Inline error -->
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="af-error">@_errorMessage</div>
        }

        <!-- Next / Finish button — disabled for 3 s after each question loads -->
        <button class="btn btn-primary af-next"
                type="button"
                disabled="@(!_nextEnabled)"
                @onclick="OnNextClickedAsync">
            @if (!_nextEnabled)
            {
                <span>Please wait…</span>
            }
            else if (_currentIndex == _questions.Count - 1)
            {
                <span>Finish</span>
            }
            else
            {
                <span>Next</span>
            }
        </button>

        <!-- Cancel -->
        <button class="btn btn-ghost af-cancel"
                type="button"
                @onclick="OnCancelClickedAsync">
            Cancel
        </button>
    }
</div>

@code {
    // ── Parameters ─────────────────────────────────────────────────────────────

    /// <summary>Raised when the user passes all 5 questions correctly.</summary>
    [Parameter] public EventCallback OnFlowCompleted { get; set; }

    /// <summary>Raised when the user clicks Cancel, or when an early-exit answer is given.</summary>
    [Parameter] public EventCallback OnCancelled { get; set; }

    // ── State ──────────────────────────────────────────────────────────────────

    private int    _currentIndex  = 0;
    private string _typedAnswer   = "";
    private string _errorMessage  = "";
    private bool   _nextEnabled   = false;
    private bool   _disposed      = false;

    /*
     * _pasteListenerAttached prevents the OnAfterRenderAsync from attaching
     * the paste-prevention listener more than once when the component re-renders
     * on Q5 (e.g. after the timer fires and StateHasChanged() is called).
     */
    private bool _pasteListenerAttached = false;

    private System.Threading.Timer? _countdownTimer;

    // ── Questions ──────────────────────────────────────────────────────────────
    /*
     * Questions are fixed at component definition time.
     * Q3 (index 2): "urge" is a valid answer but triggers OnCancelled — see OnNextClickedAsync.
     * Q4 (index 3): "no"   is a valid answer but triggers OnCancelled — see OnNextClickedAsync.
     * Q5 (index 4): validated dynamically against QuoteService.CurrentQuoteText (text only, no author).
     */
    private readonly IReadOnlyList<(string Question, string[] Accepted)> _questions =
    [
        (
            "Where are you right now?",
            new[] { "home", "work", "elsewhere" }
        ),
        (
            "Who are you with?",
            new[] { "myself", "family", "friends" }
        ),
        (
            "Why are you doing this?",
            new[] { "forgot password", "urge", "setting up" }
        ),
        (
            "Do you really want to do this?",
            new[] { "yes", "no" }
        ),
        (
            "What is today's inspirational quote?",
            Array.Empty<string>()   // validated dynamically — see GetNormalizedQuote()
        ),
    ];

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override void OnInitialized() => StartQuestionTimer();

    /*
     * OnAfterRenderAsync()
     * Attaches a paste-prevention listener to the quote input (id="af-quote-input")
     * the first time Q5 is rendered. Uses optional chaining (?.) so no JS error
     * is thrown if the element isn't in the DOM yet on the render that fires the timer.
     *
     * This mirrors the pattern in GuardianFlow.razor — the user must type the quote
     * character by character without pasting, which provides a meaningful grounding moment.
     */
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_currentIndex == _questions.Count - 1 && !_pasteListenerAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("eval",
                    "document.getElementById('af-quote-input')?.addEventListener('paste', e => e.preventDefault())");
                _pasteListenerAttached = true;
            }
            catch
            {
                // JS interop unavailable (e.g. pre-render) — silently skip
            }
        }
    }

    // ── Timer ──────────────────────────────────────────────────────────────────

    /*
     * StartQuestionTimer()
     * Fires once after 3 seconds to enable the Next button.
     * The mandatory wait prevents the user from racing through questions reflexively.
     * Uses Timeout.Infinite so the timer fires exactly once per question.
     * InvokeAsync marshals the StateHasChanged call to the Blazor sync context.
     */
    private void StartQuestionTimer()
    {
        _countdownTimer?.Dispose();
        _nextEnabled = false;

        _countdownTimer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            _nextEnabled = true;
            InvokeAsync(StateHasChanged);
        }, null, dueTime: 3000, period: System.Threading.Timeout.Infinite);
    }

    // ── Answer Handling ────────────────────────────────────────────────────────

    private async Task OnNextClickedAsync()
    {
        if (!_nextEnabled) return;

        var normalized    = QuoteText.Normalize(_typedAnswer);
        bool isLastQuestion = _currentIndex == _questions.Count - 1;

        // ── Validate ───────────────────────────────────────────────────────────
        bool correct = isLastQuestion
            ? normalized == GetNormalizedQuote()
            : _questions[_currentIndex].Accepted.Contains(normalized);

        if (!correct)
        {
            _errorMessage = "That is not a valid answer, please try again.";
            return;
        }

        // ── Early-exit checks ──────────────────────────────────────────────────
        /*
         * Q3 "urge": the user has admitted they are acting on impulse.
         *            Cancel the flow so the site is not unblocked.
         * Q4 "no":   the user has said they do NOT really want to do this.
         *            Cancel the flow for the same reason.
         * Both are valid answers that pass validation — the exit is intentional,
         * not a punishment. The user can re-open the flow whenever they like.
         */
        if (_currentIndex == 2 && normalized == "urge")
        {
            await OnCancelled.InvokeAsync();
            return;
        }

        if (_currentIndex == 3 && normalized == "no")
        {
            await OnCancelled.InvokeAsync();
            return;
        }

        // ── Advance ────────────────────────────────────────────────────────────
        _errorMessage = "";
        _typedAnswer  = "";
        _currentIndex++;

        if (_currentIndex >= _questions.Count)
        {
            await OnFlowCompleted.InvokeAsync();
            return;
        }

        StartQuestionTimer();
    }

    private async Task OnCancelClickedAsync()
        => await OnCancelled.InvokeAsync();

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _nextEnabled)
            await OnNextClickedAsync();
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    /*
     * GetHint()
     * Q1–Q4: the accepted answers joined by " · " so the user knows what to type.
     * Q5:    a plain instruction — the quote is displayed in the box above the input.
     */
    private string GetHint()
        => _currentIndex == _questions.Count - 1
            ? "Type the quote above exactly (no author) to continue"
            : string.Join(" · ", _questions[_currentIndex].Accepted);

    // Q5 accepts the quote TEXT only (no author) — see slice 011.
    private string GetNormalizedQuote()
        => QuoteText.Normalize(QuoteService.CurrentQuoteText);

    // ── Cleanup ────────────────────────────────────────────────────────────────

    public void Dispose()
    {
        _disposed = true;
        _countdownTimer?.Dispose();
    }
}
