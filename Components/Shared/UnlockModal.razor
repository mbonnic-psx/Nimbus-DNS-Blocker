@inject IPasswordService PasswordService

@if (IsVisible)
{
    <div class="um-overlay">

        @if (_currentView == "password")
        {
            <!-- Password view — only shown in Guardian mode -->
            <div class="um-card">

                <h2 class="um-title">Unlock Nimbus</h2>

                <!--
                    Using @value + @oninput instead of @bind so we can clear the
                    error message the moment the user starts typing again (Part 4).
                -->
                <input class="input"
                       type="password"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       value="@_passwordAttempt"
                       @oninput="OnPasswordInput"
                       @onkeydown="OnPasswordKeyDownAsync" />

                <!-- Inline error — set by OnSubmitClickedAsync, cleared by OnPasswordInput -->
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="um-error">@_errorMessage</div>
                }

                <!-- Unlock button — disabled until the user has typed something -->
                <button class="btn btn-primary um-submit"
                        type="button"
                        disabled="@(_passwordAttempt.Length == 0)"
                        @onclick="OnSubmitClickedAsync">
                    Unlock
                </button>

                <!--
                    "Forgot your password?" is only relevant in Guardian mode.
                    In Accountability mode the user has no password to forget,
                    so this link is suppressed entirely.
                -->
                @if (!PasswordService.IsAccountabilityModeActive())
                {
                    <button class="btn btn-ghost um-forgot"
                            type="button"
                            @onclick="OnForgotClicked">
                        Forgot your password?
                    </button>
                }

                <!-- Cancel — closes the modal without applying -->
                <button class="btn btn-ghost um-cancel"
                        type="button"
                        @onclick="OnCancelClickedAsync">
                    Cancel
                </button>

            </div>
        }
        else if (_currentView == "accountability")
        {
            <!-- AccountabilityFlow renders its own af-container card -->
            <AccountabilityFlow OnFlowCompleted="HandleFlowCompleted"
                                OnCancelled="ReturnToPassword" />
        }
        else if (_currentView == "guardian")
        {
            <!-- GuardianFlow renders its own gf-container card -->
            <GuardianFlow OnFlowCompleted="HandleFlowCompleted"
                          OnCancelled="ReturnToPassword" />
        }

    </div>
}

@code {
    // ── Parameters ─────────────────────────────────────────────────────────────

    /// <summary>Controls whether the modal is rendered. When false nothing is added to the DOM.</summary>
    [Parameter] public bool IsVisible { get; set; }

    /// <summary>Raised when the user successfully authenticates (password or recovery flow).</summary>
    [Parameter] public EventCallback OnUnlocked { get; set; }

    /// <summary>Raised when the user dismisses the modal without authenticating.</summary>
    [Parameter] public EventCallback OnCancelled { get; set; }

    // ── State ──────────────────────────────────────────────────────────────────

    private string _passwordAttempt = "";
    private string _errorMessage    = "";
    private string _currentView     = "password"; // "password" | "accountability" | "guardian"

    /*
     * _wasVisible tracks the previous IsVisible value so OnParametersSet()
     * can detect the exact moment the modal transitions from hidden → visible
     * and route to the correct starting view.
     */
    private bool _wasVisible = false;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    /*
     * OnParametersSet()
     * Fires every time the parent re-renders and pushes new parameter values.
     * On the false→true transition we reset all state and choose the starting view:
     *
     *   Accountability mode active → skip the password view, go straight to
     *   AccountabilityFlow so the user is never asked for a password they don't have.
     *
     *   Guardian mode active → start on the password entry view as normal.
     */
    protected override void OnParametersSet()
    {
        if (IsVisible && !_wasVisible)
        {
            _passwordAttempt = "";
            _errorMessage    = "";

            _currentView = PasswordService.IsAccountabilityModeActive()
                ? "accountability"
                : "password";
        }

        _wasVisible = IsVisible;
    }

    // ── Password Input Handler ─────────────────────────────────────────────────

    /*
     * OnPasswordInput()
     * Fires on every keystroke in the password field.
     * Updates the bound value AND clears any stale error message so the user
     * gets immediate feedback that their new attempt is being recorded.
     * This is why we use @value + @oninput rather than @bind — we need control
     * over what happens on each input event.
     */
    private void OnPasswordInput(ChangeEventArgs e)
    {
        _passwordAttempt = e.Value?.ToString() ?? "";

        if (!string.IsNullOrEmpty(_errorMessage))
            _errorMessage = "";
    }

    // ── Password View Handlers ─────────────────────────────────────────────────

    /*
     * OnSubmitClickedAsync()
     * Verifies the typed password against the stored PBKDF2 hash.
     * On success: invokes OnUnlocked so the parent can proceed.
     * On failure: shows an error message. Does NOT clear the typed password
     *             so the user can see what they typed and identify the mistake.
     *             The error clears automatically on the next keystroke via OnPasswordInput.
     */
    private async Task OnSubmitClickedAsync()
    {
        bool correct = PasswordService.VerifyPassword(_passwordAttempt);

        if (correct)
        {
            await OnUnlocked.InvokeAsync();
        }
        else
        {
            _errorMessage = "Incorrect password, please try again.";
        }
    }

    /*
     * OnForgotClicked()
     * Only reachable in Guardian mode (the link is hidden in Accountability mode).
     * Switches to the GuardianFlow recovery view.
     */
    private void OnForgotClicked()
    {
        _currentView = "guardian";
    }

    private async Task OnCancelClickedAsync()
        => await OnCancelled.InvokeAsync();

    /*
     * OnPasswordKeyDownAsync()
     * Enter key submits the password — standard password-field UX.
     * Only fires if there is actually something typed.
     */
    private async Task OnPasswordKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && _passwordAttempt.Length > 0)
            await OnSubmitClickedAsync();
    }

    // ── Recovery Flow Handlers ─────────────────────────────────────────────────

    /*
     * HandleFlowCompleted()
     * Called by AccountabilityFlow (normal accountability auth) and by
     * GuardianFlow (guardian recovery — user forgot their password).
     *
     * Guardian recovery only: calls ClearPasswordAsync() so the recovered user
     * has free access immediately and must set a new password in Settings.
     * Accountability mode is intentionally NOT cleared — users should still need
     * to answer questions on every subsequent Apply click.
     */
    private async Task HandleFlowCompleted()
    {
        if (_currentView == "guardian")
            await PasswordService.ClearPasswordAsync();

        await OnUnlocked.InvokeAsync();
    }

    /*
     * ReturnToPassword()
     * Called when the user cancels out of a recovery or accountability flow.
     *
     * Guardian mode: returns to the password entry view so the user can try
     * their password again or pick a different option.
     *
     * Accountability mode: there is no password view to return to, so cancelling
     * the flow dismisses the modal entirely via OnCancelled.
     */
    private async Task ReturnToPassword()
    {
        if (PasswordService.IsAccountabilityModeActive())
        {
            await OnCancelled.InvokeAsync();
            return;
        }

        _currentView     = "password";
        _errorMessage    = "";
        _passwordAttempt = "";
    }
}
