@page "/blocking"
@using Nimbus_Internet_Blocker.Models
@inject PresetService PresetService
@inject CustomSitesService CustomSitesService
@inject IHostsFileService HostsFileService
@inject ISnackbarService Snackbar
@inject IPasswordService PasswordService

<div class="blocking-page">
    <!-- Page header -->
    <div class="hero">
        <h1 class="h1">Blocking</h1>
        <p class="subhead">
            Turn categories on/off, or add custom sites to block.
        </p>
    </div>

    <!-- Two cards, side-by-side -->
    <div class="blocking-grid">
        <!-- LEFT: Categories -->
        <section class="card card-pad blocking-card">
            <div class="card-top">
                <div>
                    <h2 class="section-title">Categories</h2>
                    <div class="muted">Loaded @_categoryCount categories</div>
                </div>
            </div>

            <div class="category-list">
                @if (_presets?.Categories != null)
                {
                    @foreach (var keyValuePair in _presets.Categories)
                    {
                        var name = keyValuePair.Key;
                        var cat = keyValuePair.Value;

                        <div class="category-row">
                            <div class="category-name">@name</div>

                            <label class="switch" title="Enable/disable category">
                                <input type="checkbox"
                                       checked="@cat.Enabled"
                                       @onchange="async _ => await OnCategoryChangedAsync(name)" />
                                <span class="slider"></span>
                            </label>
                        </div>
                    }
                }
            </div>
        </section>

        <!-- RIGHT: Custom -->
        <section class="card card-pad blocking-card">
            <div class="card-top">
                <div>
                    <h2 class="section-title">Custom Sites</h2>
                    <div class="muted">Add your own domains to block.</div>
                </div>

                <button class="btn btn-ghost"
                        type="button"
                        @onclick="() => _customOpen = !_customOpen">
                    List (@(_customRoot?.Sites?.Count ?? 0))
                </button>
            </div>

            <div class="custom-add">
                <input class="input"
                       placeholder="example.com"
                       @bind="_customInput"
                       @bind:event="oninput"
                       @onkeydown="OnCustomInputKeyDown" />

                <button class="btn btn-primary"
                        type="button"
                        @onclick="AddCustomAsync">
                    Add
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_customMessage))
            {
                <div class="dim" style="margin-top:10px;">
                    @_customMessage
                </div>
            }

            @if (_customOpen)
            {
                <div class="custom-dropdown">
                    @if (_customRoot == null || _customRoot.Sites.Count == 0)
                    {
                        <div class="placeholder">No custom sites yet.</div>
                    }
                    else
                    {
                        @foreach (var site in _customRoot.Sites)
                        {
                            <div class="entry-pill" style="margin-bottom:10px;">
                                <div class="entry-host">@site.Host</div>

                                <label class="switch" title="Enable/disable @site.Host">
                                    <input type="checkbox"
                                           checked="@(site.Enabled ?? true)"
                                           @onchange="async e => await ToggleCustomEnabledAsync(site, e)" />
                                    <span class="slider"></span>
                                </label>

                                <button class="btn btn-remove"
                                        type="button"
                                        title="Remove @site.Host"
                                        @onclick="async () => await RemoveCustomAsync(site.Host)">
                                    🗑
                                </button>
                            </div>
                        }
                    }
                </div>
            }
        </section>
    </div>

    <!-- Elevation warning -->
    @if (!HostsFileService.IsElevated)
    {
        <div class="apply-row">
            <div class="admin-warning">
                ⚠ Nimbus is not running as Administrator — blocking rules cannot be applied.
                Right-click the app and choose <strong>Run as administrator</strong>.
            </div>
        </div>
    }

    <!-- Apply button -->
    <div class="apply-row">
        <button class="btn btn-primary apply-btn"
                type="button"
                disabled="@(_isApplying || !HostsFileService.IsElevated)"
                @onclick="OnApplyClicked">
            @if (_isApplying)
            {
                <span>Applying…</span>
            }
            else
            {
                <span>Apply Blocking Rules</span>
            }
        </button>
    </div>

    <!-- Apply status message — green on success, red on failure, cleared on any change -->
    @if (!string.IsNullOrEmpty(_applyStatusMessage))
    {
        <div class="apply-status-row">
            <span class="@(_changesApplied ? "apply-status apply-status-success" : "apply-status apply-status-error")">
                @_applyStatusMessage
            </span>
        </div>
    }

    <UnlockModal IsVisible="_showUnlockModal"
                 OnUnlocked="OnUnlocked"
                 OnCancelled="OnModalCancelled" />
</div>

@code {
    // ── State ──────────────────────────────────────────────────────────────────

    private PresetsRoot? _presets;
    private int _categoryCount;

    private CustomsRoot? _customRoot;
    private string _customInput  = "";
    private bool   _customOpen   = true;
    private string _customMessage = "";

    private bool _isApplying      = false;
    private bool _showUnlockModal = false;

    /*
     * _appliedPresetsSnapshot holds the last preset state that was successfully
     * applied (seeded from the initial load). If the user flips category toggles
     * and then cancels the unlock modal, OnModalCancelled restores this snapshot to
     * both memory and disk so the switches reflect what is actually applied.
     */
    private PresetsRoot? _appliedPresetsSnapshot = null;

    /*
     * _applyStatusMessage and _changesApplied drive the small status line
     * shown below the Apply button. Both are cleared whenever the user modifies
     * any category or custom site so stale success/failure text never lingers.
     */
    private string _applyStatusMessage = "";
    private bool   _changesApplied     = false;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _presets = await PresetService.LoadAsync();
        _categoryCount = _presets?.Categories?.Count ?? 0;

        _appliedPresetsSnapshot = DeepCopy(_presets);

        _customRoot = await CustomSitesService.LoadAsync();
    }

    // ── Category Management ────────────────────────────────────────────────────

    private async Task OnCategoryChangedAsync(string name)
    {
        ClearApplyStatus();

        if (_presets is null) return;
        if (!_presets.Categories.TryGetValue(name, out var cat)) return;

        cat.Enabled = !cat.Enabled;
        await PresetService.SaveAsync(_presets);
    }

    // ── Custom Sites ───────────────────────────────────────────────────────────

    private async Task AddCustomAsync()
    {
        ClearApplyStatus();
        _customMessage = "";

        if (_customRoot == null)
            _customRoot = await CustomSitesService.LoadAsync();

        var (success, message, updatedRoot) = await CustomSitesService.AddCustomSite(_customInput);

        _customRoot    = updatedRoot;
        _customMessage = message;

        if (success)
            _customInput = "";
    }

    private async Task RemoveCustomAsync(string host)
    {
        ClearApplyStatus();

        var (success, message, updatedRoot) = await CustomSitesService.RemoveCustomSiteAsync(host);

        _customRoot = updatedRoot;

        if (success)
            Snackbar.Success("Site removed", message);
        else
            Snackbar.Error("Remove failed", message);
    }

    private async Task ToggleCustomEnabledAsync(CustomEntry site, ChangeEventArgs e)
    {
        ClearApplyStatus();

        if (_customRoot is null) return;

        bool newValue = false;

        if (e.Value is bool b) newValue = b;
        else if (e.Value is string s && bool.TryParse(s, out var parsed)) newValue = parsed;

        site.Enabled = newValue;

        CustomSitesService.NormalizeCustoms(_customRoot);
        await CustomSitesService.SaveAsync(_customRoot);
    }

    private async Task OnCustomInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AddCustomAsync();
    }

    // ── Apply Logic ────────────────────────────────────────────────────────────

    /*
     * OnApplyClicked()
     * Single entry point for the Apply Blocking Rules button.
     *
     * No protection configured → applies directly with Applying… state.
     *
     * Guardian or Accountability mode active → opens the unlock modal. The actual
     * ApplyAsync call happens only after the user successfully authenticates via
     * OnUnlocked().
     */
    private async Task OnApplyClicked()
    {
        if (_isApplying) return;

        bool needsAuth = PasswordService.IsPasswordEnabled()
                      || PasswordService.IsAccountabilityModeActive();

        if (!needsAuth)
        {
            _isApplying = true;
            StateHasChanged();

            try
            {
                await HostsFileService.ApplyAsync();
                _applyStatusMessage = "Changes applied successfully";
                _changesApplied     = true;
                _appliedPresetsSnapshot = DeepCopy(_presets);
            }
            catch
            {
                _applyStatusMessage = "Failed to apply changes, please try again";
                _changesApplied     = false;
            }

            _isApplying = false;
            return;
        }

        _showUnlockModal  = true;
        StateHasChanged();
    }

    /*
     * OnUnlocked()
     * Called by UnlockModal when the user passes authentication.
     * Closes the modal, then performs the actual apply wrapped in try/catch for
     * status feedback. On success, refreshes the last-applied snapshot so a later
     * cancel reverts to this new state rather than the original one.
     */
    private async Task OnUnlocked()
    {
        _showUnlockModal  = false;
        _isApplying       = true;
        StateHasChanged();

        try
        {
            await HostsFileService.ApplyAsync();
            _applyStatusMessage = "Changes applied successfully";
            _changesApplied     = true;
            _appliedPresetsSnapshot = DeepCopy(_presets);
        }
        catch
        {
            _applyStatusMessage = "Failed to apply changes, please try again";
            _changesApplied     = false;
        }

        _isApplying = false;
    }

    /*
     * OnModalCancelled()
     * The user backed out of the unlock modal without authenticating. Restore the
     * category toggles to the last-applied state — in memory and on disk — so the
     * switches never show unapplied pending changes.
     */
    private async Task OnModalCancelled()
    {
        _showUnlockModal = false;

        if (_appliedPresetsSnapshot is not null)
        {
            _presets       = DeepCopy(_appliedPresetsSnapshot);
            _categoryCount = _presets?.Categories?.Count ?? 0;
            await PresetService.SaveAsync(_presets);
            StateHasChanged();
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    /*
     * ClearApplyStatus()
     * Resets the status line below the Apply button. Called at the start of
     * every operation that modifies the blocking state so stale success or
     * failure messages never linger after the user makes further changes.
     */
    private void ClearApplyStatus()
    {
        _applyStatusMessage = "";
        _changesApplied     = false;
    }

    /*
     * DeepCopy()
     * Produces an independent copy of a PresetsRoot so mutations to _presets
     * after the snapshot is taken do not corrupt the snapshot.
     * Uses explicit LINQ projection rather than JSON round-trip to avoid
     * needing a System.Text.Json namespace in the component.
     */
    private static PresetsRoot? DeepCopy(PresetsRoot? source)
    {
        if (source is null) return null;

        return new PresetsRoot
        {
            Categories = source.Categories.ToDictionary(
                kvp => kvp.Key,
                kvp => new PresetCategory
                {
                    Enabled = kvp.Value.Enabled,
                    Entries = kvp.Value.Entries
                        .Select(e => new PresetEntry
                        {
                            Host = e.Host,
                            Ipv4 = e.Ipv4,
                            Ipv6 = e.Ipv6
                        })
                        .ToList()
                })
        };
    }
}
